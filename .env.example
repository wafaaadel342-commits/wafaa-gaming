# ---------------------------------------------------------------------------
# Client-side (Vite) configuration
# ---------------------------------------------------------------------------
# OpenRouter key used by the EXISTING in-browser generation system (localStorage
# mode). Leave empty to rely on the built-in offline bank. In production,
# prefer the server-side Cloud Functions generation (functions/src/index.ts)
# and keep this key out of the client bundle.
VITE_OPENROUTER_API_KEY=

# ---------------------------------------------------------------------------
# Server-side only (NEVER expose to Vite / the browser)
# ---------------------------------------------------------------------------
# Used by src/lib/parallel-ai.ts when running in a server context, and by the
# Cloud Functions generation worker.
OPENROUTER_API_KEY=

# Firebase project id (client config already hard-coded in src/lib/fb-config.ts;
# this is for server tooling / scripts).
FIREBASE_PROJECT_ID=wafaa-game

# Secret required by the `seedDatabase` Cloud Function (categories + fallback
# question bank). Set the SAME value in Firebase Functions secrets:
#   firebase functions:secret:set ADMIN_SEED_SECRET
ADMIN_SEED_SECRET=

# ---------------------------------------------------------------------------
# Firebase Admin SDK credentials
# ---------------------------------------------------------------------------
# DO NOT commit a service account JSON file. Preferred: Workload Identity /
# Application Default Credentials in the deployed environment.
# For local emulator/testing only, you may point to a JSON file OUTSIDE the repo:
# GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\service-account.json
